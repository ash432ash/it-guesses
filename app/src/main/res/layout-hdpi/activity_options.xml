<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    tools:context="com.ash432.itguesses.options"
    android:background="#040404"
    android:clickable="false"
    android:orientation="vertical"
    android:id="@+id/rel"
    android:screenOrientation="portrait">


    <TextView
        android:layout_width="160dp"
        android:layout_height="20dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="@string/song_credits"
        android:id="@+id/song_credits"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:layout_above="@+id/song_name"
        android:layout_centerHorizontal="true"
        android:gravity="center"
         />

    <TextView
        android:layout_width="200dp"
        android:layout_height="20dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="@string/quot_the_fatrat_xenogenisis_quot"
        android:textColorLink="#FF3D43F2"
        android:id="@+id/song_name"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="14dp"
       />

    <TextView
        android:layout_width="240dp"
        android:layout_height="28dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="@string/headphones_recommended"
        android:id="@+id/textView"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="31dp"
        android:layout_above="@+id/song_credits"
        android:layout_alignLeft="@+id/instruct"
        android:layout_alignStart="@+id/instruct" />


    <Button
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="@string/play"
        android:id="@+id/play"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="30sp"
        android:clickable="true"
        android:layout_marginTop="36dp"
        android:layout_below="@+id/title"
        android:layout_alignLeft="@+id/hints"
        android:layout_alignStart="@+id/hints"
        android:gravity="center"/>

    <TextView
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:text="@string/it_guesses"
        android:id="@+id/title"

        android:focusable="false"
        android:enabled="false"
        android:textColor="#ffffff"
        android:textSize="50sp"
        android:textStyle="bold|italic"
        android:layout_marginTop="44dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:focusableInTouchMode="false"
        android:lines="@integer/cancel_button_image_alpha" />

    <Button
        android:layout_width="240dp"
        android:layout_height="40dp"
        android:text="@string/how_to_play"
        android:id="@+id/instruct"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="30sp"
        android:clickable="true"
        android:layout_below="@+id/play"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:gravity="center"/>

    <Button
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="@string/hints"
        android:id="@+id/hints"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="30sp"
        android:clickable="true"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/instruct"
        android:layout_centerHorizontal="true"
        android:gravity="center"/>

    <Button
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:text="@string/exit"
        android:id="@+id/exit"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="30sp"
        android:clickable="true"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/hints"
        android:layout_centerHorizontal="true"
        android:gravity="center"/>


</RelativeLayout>
