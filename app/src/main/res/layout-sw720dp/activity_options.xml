<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    tools:context="com.ash432.itguesses.options"
    android:background="#040404"
    android:clickable="false"
    android:orientation="vertical"
    android:id="@+id/rel"
    android:screenOrientation="portrait">


    <TextView
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="@string/song_credits"
        android:id="@+id/song_credits"
        android:textColor="#ffffff"
        android:textSize="32sp"
        android:gravity="center"
        android:layout_above="@+id/song_name"
        android:layout_centerHorizontal="true" />

    <TextView
        android:layout_width="450dp"
        android:layout_height="40dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="@string/quot_the_fatrat_xenogenisis_quot"
        android:textColorLink="#FF3D43F2"
        android:id="@+id/song_name"
        android:textColor="#ffffff"
        android:textSize="32sp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="14dp"
        android:gravity="center" />

    <TextView
        android:layout_width="500dp"
        android:layout_height="70dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="@string/headphones_recommended"
        android:id="@+id/textView"
        android:textColor="#ffffff"
        android:textSize="37sp"
        android:gravity="center"
        android:layout_marginBottom="29dp"
        android:layout_above="@+id/song_credits"
        android:layout_centerHorizontal="true" />


    <Button
        android:layout_width="270dp"
        android:layout_height="130dp"
        android:text="@string/play"
        android:id="@+id/play"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="60sp"
        android:clickable="true"
        android:layout_marginTop="60dp"
        android:layout_below="@+id/title"
        android:layout_alignLeft="@+id/song_credits"
        android:layout_alignStart="@+id/song_credits" />

    <TextView
        android:layout_width="700dp"
        android:layout_height="150dp"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:text="@string/it_guesses"
        android:id="@+id/title"

        android:focusable="false"
        android:enabled="false"
        android:textColor="#ffffff"
        android:textStyle="bold|italic"
        android:layout_marginTop="117dp"
        android:gravity="center"
        android:textSize="115sp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true" />

    <Button
        android:layout_width="460dp"
        android:layout_height="130dp"
        android:text="@string/how_to_play"
        android:id="@+id/instruct"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="60sp"
        android:clickable="true"
        android:layout_below="@+id/play"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp" />

    <Button
        android:layout_width="270dp"
        android:layout_height="130dp"
        android:text="@string/hints"
        android:id="@+id/hints"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="60sp"
        android:clickable="true"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/instruct"
        android:layout_centerHorizontal="true" />

    <Button
        android:layout_width="270dp"
        android:layout_height="130dp"
        android:text="@string/exit"
        android:id="@+id/exit"
        android:textColor="@color/button_color"
        android:background="@drawable/sd"
        android:textSize="60sp"
        android:clickable="true"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/hints"
        android:layout_centerHorizontal="true" />


</RelativeLayout>
