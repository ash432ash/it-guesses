<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" >
    <shape>
        <corners
            android:radius="60dp"
            />
        <gradient
            android:angle="45"
            android:centerX="35%"
            android:centerColor="#000000"
            android:startColor="#000000"
            android:endColor="#000000"
            android:type="linear"
            />
        <size
            android:width="60dp"
            android:height="60dp"
            />
        <stroke
            android:width="3dp"
            android:color="#878787"
            />
    </shape>
    </item>


    <item >
        <shape>
            <corners
                android:radius="60dp"
                />
            <gradient
                android:angle="45"
                android:centerX="35%"
                android:centerColor="#FFFFFF"
                android:startColor="#FFFFFF"
                android:endColor="#FFFFFF"
                android:type="linear"
                />
            <size
                android:width="60dp"
                android:height="60dp"
                />
            <size
                android:width="60dp"
                android:height="60dp"
                />
            <stroke
                android:width="3dp"
                android:color="#878787"
                />
        </shape>
    </item>
</selector>